@{
}

<form method="post" asp-controller="Home" asp-action="AskQuestion">
    <div class="form-group mt-5">
        <label for="question">Your Question:</label>
        <input class="form-control" id="question" name="question" required/>
    </div>
<button type="submit" class="btn btn-primary mt-2">Ask</button>
</form>

@if (ViewBag.Question != null)
{
    <div class="mt-4">
        <h3>Question:</h3>
        <p>@ViewBag.Question</p>
    </div>
}

@if (ViewBag.Answer != null)
{
    <div class="mt-4">
        <h3>Answer:</h3>
        <p>@ViewBag.Answer</p>
    </div>
}

